@page
@model IndexModel
@{
    ViewData["Title"] = "Local Image Generator AI";
}

<div class="text-center mt-5">
    <h1>Local Image Generator AI</h1>
    <p class="lead">Generate images from your own prompts.</p>

    <form method="post">
        <div class="mb-3">
           
            <textarea id="prompt"
                      name="Prompt"
                      class="form-control"
                      rows="4"
                      placeholder="Describe the image you want to generate..."></textarea>
        </div>

        <button type="submit" class="btn btn-primary">
            Generate Image
        </button>
    </form>


    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger mt-4">
            @Model.ErrorMessage
        </div>
    }


     @if (!string.IsNullOrWhiteSpace(Model.SubmittedPrompt))
    {
        <div class="alert alert-success mt-4">
            <strong>Your prompt:</strong>
            <p class="mb-0">@Model.SubmittedPrompt</p>
        </div>
    }
 
</div>