@page
@model IndexModel
@{
    ViewData["Title"] = "Local Image Generator AI";
}

<div class="text-center mt-5">
    <h1>Local Image Generator AI</h1>
    <p class="lead">Generate images from your own prompts.</p>

    <form method="post">
        <div class="mb-3">
            <label for="prompt" class="form-label">Your prompt</label>
            <textarea id="prompt"
                      name="Prompt"
                      class="form-control"
                      rows="4"
                      placeholder="Describe the image you want to generate..."></textarea>
        </div>

        <button type="submit" class="btn btn-primary">
            Generate Image
        </button>
    </form>
   
